################################################### 
# SHAOLIN / LLVM 22 / OpenMPI 5.0.11 on DEBIAN 13 #
################################################### 

%NCDF_HOME           /opt/hdf5_netcdf4_llvm_ompi5
%HDF5_HOME           /opt/hdf5_netcdf4_llvm_ompi5
%XIOS_HOME           /opt/xios2-trunk_openmpi-5.0.11_llvm-22

%NCDF_INC            -I%NCDF_HOME/include
%NCDF_LIB            -L%NCDF_HOME/lib -lnetcdf -lnetcdff -L%HDF5_HOME/lib -lhdf5_hl -lhdf5 -lhdf5 -L/usr/lib64 -lz -lcurl -lstdc++

%XIOS_INC            -I%XIOS_HOME/inc 
%XIOS_LIB            -L%XIOS_HOME/lib -lxios


%FC                  mpif90

%BASE_FFLAGS          -fdefault-integer-4 -fdefault-real-8 -fdefault-double-8 -ffp-contract=off

%PROD_FFLAGS          -O3 -march=native

%DEV_FFLAGS           -O0 -g

#######################################################

# Production on CPU only:
# ~~~~~~~~~~~~~~~~~~~~~~~
%FPPFLAGS            -P  -traditional
%FCFLAGS             %BASE_FFLAGS %PROD_FFLAGS
#
# Debug on CPU only:
# ~~~~~~~~~~~~~~~~~~
###%FPPFLAGS            -P  -traditional -D_TRDBG
#%FPPFLAGS            -P  -traditional -Dkey_verbose
#%FCFLAGS             %BASE_FFLAGS %DEV_FFLAGS

%FFLAGS              %FCFLAGS

%CPP	             cpp

###%FPPFLAGS            -P  -traditional -D_TRDBG
%FPPFLAGS            -P  -traditional -Dkey_dbgvel


%LD                  mpif90
%LDFLAGS             -lstdc++

%AR                  ar
%ARFLAGS             curv

%MK                  make

%USER_INC            %XIOS_INC %NCDF_INC
%USER_LIB            %XIOS_LIB %NCDF_LIB

%CC                  mpicc
%CFLAGS              -O2
