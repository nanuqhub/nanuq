# VAARA / brodeau nvidia/NVFORTRAN with OpenACC

%NCDF_HOME           /opt/hdf5_netcdf4_nvidia_par
%HDF5_HOME           /opt/hdf5_netcdf4_nvidia_par
%XIOS_HOME           /opt/xios2

%NCDF_INC            -I%NCDF_HOME/include
%NCDF_LIB            -L%NCDF_HOME/lib -lnetcdf -lnetcdff -L%HDF5_HOME/lib -lhdf5_hl -lhdf5 -lhdf5 -L/usr/lib64 -lz -lcurl -lstdc++

%XIOS_INC            -I%XIOS_HOME/inc 
%XIOS_LIB            -L%XIOS_HOME/lib -lxios


%FC                  mpif90





%BASE_FFLAGS         -i4 -r8 -Minit-integer=zero -Minit-real=zero

%PROD_FFLAGS         -O3

%DEV_FFLAGS          -Kieee -g -Mbounds -O1 -traceback -Minit-logical=false -C -Ktrap=divz,fp,ovf -ffpe-trap=invalid,zero,overflow


############
# OpenACC: #
############
%GPU_BASE_FLAGS      -acc=gpu -gpu=cc120,fastmath -Minfo=accel
%GPU_DEV_FLAGS       -gpu=nofma -Mnofma -gpu=zeroinit 
%GPU_PROD_FLAGS      
%GPU_FPP_FLAGS       -D_OPENACC



#######################################################


# Production with GPU:
# ~~~~~~~~~~~~~~~~~~~~
%FPPFLAGS            -P  -traditional %GPU_FPP_FLAGS
%FCFLAGS             %BASE_FFLAGS %PROD_FFLAGS %GPU_BASE_FLAGS %GPU_PROD_FLAGS
#
# Debug with GPU:
# ~~~~~~~~~~~~~~
###%FPPFLAGS            -P  -traditional %GPU_FPP_FLAGS -D_TRDBG
#%FPPFLAGS            -P  -traditional %GPU_FPP_FLAGS
#%FCFLAGS             %BASE_FFLAGS %DEV_FFLAGS %GPU_BASE_FLAGS %GPU_DEV_FLAGS


# Production on CPU only:
# ~~~~~~~~~~~~~~~~~~~~~~~
#%FPPFLAGS            -P  -traditional
#%FCFLAGS             %BASE_FFLAGS %PROD_FFLAGS
#
# Debug on CPU only:
# ~~~~~~~~~~~~~~~~~~
###%FPPFLAGS            -P  -traditional -D_TRDBG
#%FPPFLAGS            -P  -traditional
#%FCFLAGS             %BASE_FFLAGS %DEV_FFLAGS



## -ffpe-trap=invalid|zero|overflow|underflow|inexact

%FFLAGS              %FCFLAGS

%CPP	             cpp

%LD                  mpif90 %FCFLAGS
%LDFLAGS             -lacchost

%AR                  ar
%ARFLAGS             curv

%MK                  make

%USER_INC            %XIOS_INC %NCDF_INC
%USER_LIB            %XIOS_LIB %NCDF_LIB

%CC                  mpicc
%CFLAGS              -O3
