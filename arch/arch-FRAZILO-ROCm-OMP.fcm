##############################################################
# FRAZILO (Mac Pro / Debian 13) / AMD's ROCm 7.2 / OpenMPI 5 #
##############################################################

%NCDF_HOME           /opt/hdf5_netcdf4_rocm_ompi5
%HDF5_HOME           /opt/hdf5_netcdf4_rocm_ompi5
%XIOS_HOME           /opt/xios2-trunk_rocm_ompi5
%OASIS_HOME

%NCDF_INC            -I%NCDF_HOME/include
%NCDF_LIB            -L%NCDF_HOME/lib -lnetcdf -lnetcdff -L%HDF5_HOME/lib -lhdf5_hl -lhdf5 -lhdf5 -L/usr/lib64 -lz -lcurl -lstdc++
%XIOS_INC            -I%XIOS_HOME/inc
%XIOS_LIB            -L%XIOS_HOME/lib -lxios

%OMP_INC             -I/opt/rocm/lib/llvm/include/flang


%FC                  mpifort

%BASE_FFLAGS         -fdefault-real-8 -finit-global-zero

%PROD_FFLAGS         -O3 -ffast-math
%DEV_FFLAGS          -O2  -g



# OpenMP:
# ~~~~~~~
%GPU_BASE_FLAGS      -fopenmp --offload-arch=gfx1010 -fopenmp-version=51 -foptimization-record-file=./optimization_remarks.out
%GPU_PROD_FLAGS
%GPU_DEV_FLAGS       
%GPU_FPP_FLAGS       -D_OPENMP
%GPU_LD_FLAGS        -fopenmp --offload-arch=gfx1010 -fopenmp-version=51



# Production with GPU:
# ~~~~~~~~~~~~~~~~~~~~
%FPPFLAGS            -P  -traditional %GPU_FPP_FLAGS
%FCFLAGS             %BASE_FFLAGS %PROD_FFLAGS %GPU_BASE_FLAGS %GPU_PROD_FLAGS
%LDFLAGS            %GPU_LD_FLAGS -lstdc++
#
# Debug with GPU:
# ~~~~~~~~~~~~~~
#%FPPFLAGS            -P  -traditional %GPU_FPP_FLAGS
#%FCFLAGS             %BASE_FFLAGS %DEV_FFLAGS %GPU_BASE_FLAGS %GPU_DEV_FLAGS
#%LDFLAGS            %GPU_LD_FLAGS -lstdc++


%FFLAGS              %FCFLAGS

%CPP	             cpp

%LD                  mpifort

%AR                  ar
%ARFLAGS             curv

%MK                  make

%USER_INC            %XIOS_INC %NCDF_INC %OMP_INC
%USER_LIB            %XIOS_LIB %NCDF_LIB

%CC                  mpicc
%CFLAGS              -O3
