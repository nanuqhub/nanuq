<?xml version="1.0"?>

<file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" sync_freq="6h" min_digits="4">

  <file_group id="1h" output_freq="1h"  output_level="10" >  <!-- 1h files -->

    <file id="file21" name_suffix="_icemod" description="ice variables" enabled=".false." >
      <!-- general -->
      <field field_ref="iceconc"        name="siconc"     operation="instant" />
      <field field_ref="icevolu"        name="sivolu"     operation="instant" />
      <field field_ref="uice"           name="u_ice"      operation="instant" />
      <field field_ref="vice"           name="v_ice"      operation="instant" />
      <field field_ref="icedmgt"        name="damage-t"   operation="instant" />
      <field field_ref="icedmgf"        name="damage-f"   operation="instant" />
    </file>

  </file_group>



  <file_group id="3h" output_freq="3h"  output_level="10" >  <!-- 3h files -->

    <file id="file31" name_suffix="_icemod" description="ice variables" enabled=".true." >
      <!-- general -->
      <field field_ref="iceconc"      name="siconc-t"  operation="instant" freq_op="3h"                                        />
      <field field_ref="icevolu"      name="sivolu-t"  operation="instant" freq_op="3h"  valid_min="0." valid_max="5."         />
      <field field_ref="icethic"      name="sithic-t"  operation="instant" freq_op="3h"                                        />
      <!--
          <field field_ref="iceconc-f"    name="siconc-f"  operation="instant" freq_op="3h"                                        />
          <field field_ref="icethic-f"    name="sithic-f"  operation="instant" freq_op="3h"                                        />
          <field field_ref="icesalt"                       operation="instant" freq_op="3h"                                        />
          <field field_ref="icetemp"                       operation="instant" freq_op="3h"                                        />
          <field field_ref="snwthic"                       operation="instant" freq_op="3h"                                        />
          <field field_ref="snwtemp"                       operation="instant" freq_op="3h"                                        />
          <field field_ref="icettop"                       operation="instant" freq_op="3h"                                        />
      -->
      <!-- -->
      <!-- rheology -->
      <!-- Traditional C-grid location: -->
      <field field_ref="icedmgt"     name="damage-t"   operation="instant" freq_op="3h"  valid_min="0."      valid_max="1."     />
      <field field_ref="icedmgf"     name="damage-f"   operation="instant" freq_op="3h"  valid_min="0."      valid_max="1."     />
      <field field_ref="icedivt"     name="sidive-t"   operation="instant" freq_op="3h"  valid_min="-0.5e-5" valid_max="0.5e-5" />
      <field field_ref="icedeft"     name="sidefo-t"   operation="instant" freq_op="3h"  valid_min="0."      valid_max="1.e-5"  />
      <field field_ref="iceshet"     name="simxshr-t"  operation="instant" freq_op="3h"  valid_min="0."      valid_max="1.e-5"  />
      <!-- momentum -->
      <field field_ref="uice"        name="u_ice-u"    operation="instant" freq_op="3h"  valid_min="-0.5" valid_max="0.5" />
      <field field_ref="vice"        name="v_ice-v"    operation="instant" freq_op="3h"  valid_min="-0.5" valid_max="0.5" />
      <!-- -->
      <!-- Ocean forcing -->
      <!--
          <field field_ref="ssu_m"                         operation="instant" freq_op="3h"  valid_min="-1.5" valid_max="1.5" />
          <field field_ref="ssv_m"                         operation="instant" freq_op="3h"  valid_min="-1.5" valid_max="1.5" />
          <field field_ref="sst_s"                         operation="instant" freq_op="3h"                                   />
          <field field_ref="sss_s"                         operation="instant" freq_op="3h"                                   />
          <field field_ref="ssh_m"                         operation="instant" freq_op="3h"                                   />
          <field field_ref="mld_m"                         operation="instant" freq_op="3h"                                   />
          <field field_ref="dsst_s"                        operation="instant" freq_op="3h"                                   />
          <field field_ref="dsss_s"                        operation="instant" freq_op="3h"                                   />
      -->
      <!-- -->
      <!-- Internal stress tensor in T-centric cell -->
      <field field_ref="ice_sig11"   name="s11-t"      operation="instant" freq_op="3h" valid_min="-5.e4" valid_max="1.e4" />
      <field field_ref="ice_sig22"   name="s22-t"      operation="instant" freq_op="3h" valid_min="-5.e4" valid_max="1.e4" />
      <field field_ref="ice_sig12"   name="s12-f"      operation="instant" freq_op="3h" valid_min="-5.e4" valid_max="5.e4" />
      <field field_ref="normstr"     name="sI-t"       operation="instant" freq_op="3h" valid_min="-5.e4" valid_max="1.e4" />
      <field field_ref="sheastr"     name="sII-t"      operation="instant" freq_op="3h" valid_min="0."    valid_max="3.e4" />
      <!-- -->
      <!-- Ridges -->
      <field field_ref="rdgc"                          operation="instant" freq_op="3h"                                    />
      <!-- -->
    </file>

  </file_group>


</file_definition>
