            zTd = 0.5_wp*( zTd_t + TimeDamagePropag( res_grd_loc_f(jif,jjf), p1mdf(jif,jjf), pxpCf(jif,jjf) ) )
            zCh = 0.5_wp*( zSc_t + pScHf(jif,jjf) )*rn_c_ref
            zI1 = psgmf(jif,jjf,1) ! @F
            zI2 = pSI2f(jif,jjf)   ! @F
            zI1 = 0.5_wp*( zI1_t + zI1 )
            zI2 = 0.5_wp*( zI2_t + zI2 )
            !! => increment
