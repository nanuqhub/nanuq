               ! *** F-centric cell:
               zS1  = pSf(ji,jj,1)
               zS2  = pSf(ji,jj,2)
               zS12 = pSf(ji,jj,3)  ! @T

               !                              !--- ds11/dx + ds12/dy  (@ V)
               ! The normal stress `s11` is split into its isotropic part `S1 = (s11+s22)/2` and its deviatoric part `S2 = (s11-s22)/2`,
               ! because in curvilinear coordinates they do not carry the same metric terms: `e2v*d(S1)` + `d(e2f^2*S2)/e2v`.
               ! Using `d(e2f^2*s11)/e2v` (previous form) adds a false force `~2*S1*d(e2)/e2v` wherever `e2` varies along `i`.
               ! With the current storage convention, `pSf(:,:,1)` is already `S1` (=sigma_1) and `pSf(:,:,2)` is already `S2` (=sigma_2),
               ! so they are used as is: no conversion from `s11` & `s22` is needed here.

               zdivSx_f = ( ( zS1                            - pSf(ji-1,jj,1)                 ) *    e2v(ji,jj) &
                  &       + ( zS2            * e2f2(ji,jj)   - pSf(ji-1,jj,2) * e2f2(ji-1,jj) ) * r1_e2v(ji,jj) &
                  &       + ( pSf(ji,jj+1,3) * e1t2(ji,jj+1) - zS12           * e1t2(ji,jj)   ) * r1_e1v(ji,jj) &
                  &       ) * zmltV

               !                              !--- ds22/dy + ds12/dx  (@ U)
               ! Same split for `s22 = S1 - S2` (hence the minus sign in front of the `S2` term): `e1u*d(S1)` - `d(e1f^2*S2)/e1u`.
               ! `S1` & `S2` at the `j-1` F-point are read directly from the stored `sigma_1` & `sigma_2`.

               zdivSy_f = ( ( zS1                            - pSf(ji,jj-1,1)                 ) *    e1u(ji,jj) &
                   &      - ( zS2            * e1f2(ji,jj)   - pSf(ji,jj-1,2) * e1f2(ji,jj-1) ) * r1_e1u(ji,jj) &
                   &      + ( pSf(ji+1,jj,3) * e2t2(ji+1,jj) - zS12           * e2t2(ji,jj)   ) * r1_e2u(ji,jj) &
                   &      ) * zmltU

#if defined key_dbgvel
               !------ for debugging only / CPP key `key_dbgvel` -------
               divSx_f(ji,jj) = zdivSx_f
               divSy_f(ji,jj) = zdivSy_f
               !--------------------------------------------------------
#endif
