               ! *** T-centric cell:
               zS1  = pSt(ji,jj,1)
               zS2  = pSt(ji,jj,2)
               zS12 = pSt(ji,jj,3)  ! @F

               !                              !--- ds11/dx + ds12/dy  (@ U)
               ! The normal stress `s11` is split into its isotropic part `S1 = (s11+s22)/2` and its deviatoric part `S2 = (s11-s22)/2`,
               ! because in curvilinear coordinates they do not carry the same metric terms: `e2u*d(S1)` + `d(e2t^2*S2)/e2u`.
               ! Using `d(e2t^2*s11)/e2u` (previous form) adds a false force `~2*S1*d(e2)/e2u` wherever `e2` varies along `i`.
               ! With the current storage convention, `pSt(:,:,1)` is already `S1` (=sigma_1) and `pSt(:,:,2)` is already `S2` (=sigma_2),
               ! so they are used as is: no conversion from `s11` & `s22` is needed here.

               zdivSx_t = ( ( pSt(ji+1,jj,1)                 - zS1                            ) *    e2u(ji,jj) &
                  &       + ( pSt(ji+1,jj,2) * e2t2(ji+1,jj) - zS2            * e2t2(ji,jj)   ) * r1_e2u(ji,jj) &
                  &       + ( zS12           * e1f2(ji,jj)   - pSt(ji,jj-1,3) * e1f2(ji,jj-1) ) * r1_e1u(ji,jj) &
                  &       ) * zmltU

               !                              !--- ds22/dy + ds12/dx  (@ V)
               ! Same split for `s22 = S1 - S2` (hence the minus sign in front of the `S2` term): `e1v*d(S1)` - `d(e1t^2*S2)/e1v`.
               ! `S1` & `S2` at the `j+1` T-point are read directly from the stored `sigma_1` & `sigma_2`.

               zdivSy_t = ( ( pSt(ji,jj+1,1)                 - zS1                            ) *    e1v(ji,jj) &
                   &      - ( pSt(ji,jj+1,2) * e1t2(ji,jj+1) - zS2            * e1t2(ji,jj)   ) * r1_e1v(ji,jj) &
                   &      + ( zS12           * e2f2(ji,jj)   - pSt(ji-1,jj,3) * e2f2(ji-1,jj) ) * r1_e2v(ji,jj) &
                   &      ) * zmltV

#if defined key_dbgvel
               !------ for debugging only / CPP key `key_dbgvel` -------
               divSx_t(ji,jj) = zdivSx_t
               divSy_t(ji,jj) = zdivSy_t
               !--------------------------------------------------------
#endif
