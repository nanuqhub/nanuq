
            !~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            ! F-points
            !~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            z1md = p1mdf(ji,jj)
            zs1  = psgmf(ji,jj,1)
            zs2  = psgmf(ji,jj,2)
            zs12 = psgmt(ji,jj,3)
            !
            zrr   = pScHf(ji,jj)    ! this is `SQRT( rn_l_ref/dx ) * h_f`
            zCohe = rn_c_ref * zrr
            !
            zTd    = TimeDamagePropag( res_grd_loc_f(ji,jj), z1md, pxpCf(ji,jj) )
            !
            zsigI  = psgmf(ji,jj,1)
            zsigII = pSI2f(ji,jj)
            !
            zinc = mc_incrmt( zsigI, zsigII, zCohe, zTd )
            zinc = zinc * pdt
            !
            p1mdf(ji,jj) = MIN( MAX( z1md - z1md * zinc , r_dmd_min ) , 1._wp )
            zs1          =           zs1 - zs1  * zinc
            zs2          =           zs2 - zs2  * zinc
            zs12         =          zs12 - zs12 * zinc
            !
            psgmf(ji,jj,1) = zs1
            psgmf(ji,jj,2) = zs2
            psgmt(ji,jj,3) = zs12
            !~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
