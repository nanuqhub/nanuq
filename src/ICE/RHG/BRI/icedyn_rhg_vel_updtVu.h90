               !
               zmsk = REAL(pm01x(ji,jj),wp)
               zA   = pAu(ji,jj)
               zVi  = pV(ji,jj,4)  ! V at u-points!
               zUi  = pV(ji,jj,1)  ! U at u-points!
               zM_dt =  pmu_dt(ji,jj)  ! M/dt    [kg m^-2 s^-1]
               zVo  =  pVoce(ji,jj,4)  ! v ocean current at u-points!
               !
               ! j-component of air-ice wind stress at U-point:
               ztau_ai = ptauy_i_u(ji,jj)
               !
               !                 !--- tau_io/(v_oce - zVi)
               zt1   = zVi - zVo
               zt2   = zUi - pVoce(ji,jj,1)
               zTauO = zA * rho0*rn_Cd_io * SQRT( zt1*zt1 + zt2*zt2 )  ! MIND: the actual stress is `zTauO * (zVo - zVi)` !!! [kg m^-2 s^-1]
               !
               !                 !--- Coriolis at Vu-points (no interpolation needed here)
               zcorio = -ff_u(ji,jj) * zUi  ! => [m s^-2]
               !
               !                 !--- Sum of external forces (explicit solution) = F + tau_ia + Coriolis + spg + tau_io
               zRHS = zdivSy_f + zA*ztau_ai + ridlzd*zM_dt*pdt*(zcorio + pgrdH(ji,jj,4)) + zTauO*zVo        ! unit is [Pa] == [kg m^-1 s^-2]
               !
               pV(ji,jj,4) = ( ( ( zM_dt * zVi + zRHS ) / MAX( epsi20, zM_dt + zTauO ) ) * zmsk           &
                  &                        + zVo * 0.01_wp                               * (1._wp - zmsk) &
                  &          ) * REAL(pm00x(ji,jj),wp)
