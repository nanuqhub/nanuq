   
               !! F-centric cell
               !! ~~~~~~~~~~~~~~
               zsigI  = psgmf(ji,jj,1)
               zsigII = pSI2f(ji,jj)
   
               zxpC = pxpCf(ji,jj)  ! `expC` [Eq.8]
               z1md = p1mdf(ji,jj)
               zml  = z1md * zxpC                 !                   => `zml = (1-d)*exp(-C*(1-A))`
   
               zE   = rn_E0 * zml                 ! elasticity [Pa] `E = E0*(1-d)*exp[-C*(1-A)]`
   
               zc0  = zml*zml                     !                   => `zc0 = [(1-d)*exp(-C*(1-A))]^2`
               ! Lambda [s] = viscosity/elasticity = `eta0*X^5 / (E0*X)` = `(eta0/E0)*X^4`, with `X = (1-d)*exp(-C*(1-A))`
               !   => computed with the precomputed ratio `r_eta0_E0` to avoid a division at each grid point:
               zL = MAX( r_eta0_E0 * zc0 * zc0 , pdt )
   
               z1_sigI = SIGN( 1._wp , zsigI ) / MAX( ABS(zsigI), epsi20 )   ! 1/SigI without the SigI=0 singularity...
   
               ! As opposed to Olason et al 2022, for which we would simply have `zPmax = pPmax_p(ji,jj)`,
               ! we want Pmax to be (pPmax_p) when PURE compression but decreases as shearing becomes
               ! increasingly important w.r.t to compression:
               zPmax = pPmax_f(ji,jj)                 ! `P_max * h` (<0)
               ! Eccentricity of the "Pmax" ellipse that crosses the `sigma_II` axis right at the cohesion value,
               ! precomputed once per big time step as `|Pmax*h| / (C*h)` (saves a division at each sub-step):
               zecc  = pEccf(ji,jj)
   
               zc0   = zecc * zsigII * z1_sigI
   
               zPmax = zPmax / SQRT( 1._wp + zc0*zc0 ) ! Effective `P_max * h`  (for sigI<0)
   
               zc0 = MERGE( 1._wp, 0._wp,  zsigI<-epsi20 )
   
               zPtld = -zc0 * MIN( zPmax*z1_sigI , 1._wp )
   
               zmul = MIN( zL/(zL + pdt*(1._wp + zPtld)) , 1._wp ) ! Multiplicator term [Eq.32]
