            zTd = 0.5_wp*( zTd_f + TimeDamagePropag( res_grd_loc_t(jit,jjt), p1mdt(jit,jjt), pxpCt(jit,jjt) ) )
            zCh = 0.5_wp*( zSc_f + pScHt(jit,jjt) )*rn_c_ref
            zI1 = psgmt(jit,jjt,1) ! @T
            zI2 = pSI2t(jit,jjt)   ! @T
            zI1 = 0.5_wp*( zI1_f + zI1 )
            zI2 = 0.5_wp*( zI2_f + zI2 )
            !! => increment
