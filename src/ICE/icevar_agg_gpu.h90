SUBROUTINE ice_var_agg_gpu()
   !!-------------------------------------------------------------------
   !!                ***  ROUTINE ice_var_agg_gpu  ***
   !!
   !! ** Purpose :   aggregates ice-thickness-category variables to
   !!              all-ice variables, i.e. it turns VGLO into VAGG
   !!
   !!       full    arrays: vt_i, vt_s, at_i, vt_ip, vt_il, at_ip
   !!       reduced arrays: the rest
   !!-------------------------------------------------------------------
   INTEGER  ::   ji, jj, jk, jl   ! dummy loop indices
   LOGICAL  ::   lDo, lDo1, lDo2
   REAL(wp) ::   zA, z1_vt_i, z1_at_i, ztm_su !, ztm_si
   !!-------------------------------------------------------------------
   IF( ln_timing )  CALL timing_start('agg_gpu')
   !$acc data present( kmsk_ice_f,kmsk_ice_t,kmsk_ice_u,kmsk_ice_v,xht,xhf,ato_i,st_i,t_i,t_su,tm_su,v_s,vt_i,vt_s,t_s,v_i,szv_i,af_i )
   !,t_si,tm_si
   ! --- integrated values
   !$acc parallel loop collapse(2)
   DO jj=Njs0, Nje0
      DO ji=Nis0, Nie0
         !
         vt_i(ji,jj) = 0._wp
         vt_s(ji,jj) = 0._wp
         at_i(ji,jj) = 0._wp
         !$acc loop seq
         DO jl=1, jpl    ! integrated values
            vt_i(ji,jj)  = vt_i(ji,jj)  + v_i(ji,jj,jl)
            vt_s(ji,jj)  = vt_s(ji,jj)  + v_s(ji,jj,jl)
            at_i(ji,jj)  = at_i(ji,jj)  + a_i(ji,jj,jl)
         END DO
         !
         zA = at_i(ji,jj)
         ato_i(ji,jj) = 1._wp - zA  ! open water fraction
         xht(ji,jj) = MERGE( 0._wp  ,  vt_i(ji,jj) / MAX(zA,epsi20)  ,  zA <= epsi20 )
         !
      END DO
   END DO
   !$acc end parallel loop

#if defined _OPENACC || defined _OPENMP
   CALL lbc_lnk_gpu( 'ice_var_agg_gpu',  xht, ato_i, vt_i, vt_s, at_i )
#else
   CALL lbc_lnk(     'ice_var_agg_gpu',  xht,'T',1._wp, ato_i,'T',1._wp, vt_i,'T',1._wp, vt_s,'T',1._wp, at_i,'T',1._wp )
#endif


   IF( ln_icethd ) THEN
      ! --- integrated values

      !$acc parallel loop collapse(2)
      DO jj=Njs0, Nje0
         DO ji=Nis0, Nie0
            !
            zA = at_i(ji,jj)
            !
            et_s(ji,jj) = 0._wp
            et_i(ji,jj) = 0._wp
            st_i(ji,jj) = 0._wp
            ztm_su      = 0._wp
            !ztm_si      = 0._wp
            !$acc loop seq
            DO jl=1, jpl
               ztm_su = ztm_su + t_su(ji,jj,jl) * a_i(ji,jj,jl)
               !ztm_si = ztm_si + t_si(ji,jj,jl) * a_i(ji,jj,jl)
               !$acc loop seq
               DO jk=1, nlay_s
                  et_s(ji,jj) = et_s(ji,jj) +   e_s(ji,jj,jk,jl)
               END DO
               !$acc loop seq
               DO jk=1, nlay_i
                  et_i(ji,jj) = et_i(ji,jj) +   e_i(ji,jj,jk,jl)
                  st_i(ji,jj) = st_i(ji,jj) + szv_i(ji,jj,jk,jl)
               END DO
            END DO
            !
            !at_ip_eff(ji,jj) = SUM( a_ip_eff(ji,jj,:) * a_i(ji,jj,:) )
            !
            z1_at_i = 1._wp / MAX( zA , epsi20 )
            lDo = zA <= epsi20
            !!GS: tm_su always needed by ABL over sea-ice
            !tm_su(ji,jj) = MERGE( rt0  ,  SUM( t_su(ji,jj,:) * a_i(ji,jj,:) ) / MAX( zA , epsi20 )  ,  lDo )
            tm_su(ji,jj) = MERGE( rt0  ,  ztm_su *z1_at_i  ,  lDo )
            !tm_si(ji,jj) = MERGE( rt0  ,  ztm_si *z1_at_i  ,  lDo )
            !
            !IF( ln_pnd_LEV .OR. ln_pnd_TOPO ) THEN
            !   at_ip(ji,jj) = 0._wp
            !   vt_ip(ji,jj) = 0._wp
            !   vt_il(ji,jj) = 0._wp
            !   !$acc loop seq
            !   DO jl=1, jpl    ! integrated values
            !      at_ip(ji,jj) = at_ip(ji,jj) + a_ip(ji,jj,jl) ! melt ponds
            !      vt_ip(ji,jj) = vt_ip(ji,jj) + v_ip(ji,jj,jl)
            !      vt_il(ji,jj) = vt_il(ji,jj) + v_il(ji,jj,jl)
            !   END DO
            !ENDIF
         END DO
      END DO
      !$acc end parallel loop

#if defined _OPENACC || defined _OPENMP
      CALL lbc_lnk_gpu( 'ice_var_agg_gpu',  tm_su, et_s, et_i, st_i )
#else
      CALL lbc_lnk(     'ice_var_agg_gpu',  tm_su,'T',1._wp, et_s,'T',1._wp, et_i,'T',1._wp, st_i,'T',1._wp )
#endif

   ENDIF !IF( ln_icethd )


   !! Ice concentration and thickness @F,U,V:

   IF( ln_use_weno_rmp ) THEN
      CALL rmpT2F_A_h_wn5s( at_i, xht, af_i, xhf )
   ELSE
      CALL do_rmpT2F( at_i, af_i,  vmin=0._wp, vmax=rn_amax, lconserv=.TRUE. )
      CALL do_rmpT2F( xht,   xhf,  vmin=0._wp,               lconserv=.TRUE. )
   ENDIF
   CALL do_rmpT2U( at_i, au_i,  vmin=0._wp, vmax=rn_amax, lconserv=.TRUE. )
   CALL do_rmpT2V( at_i, av_i,  vmin=0._wp, vmax=rn_amax, lconserv=.TRUE. )
#if defined _OPENACC || defined _OPENMP
   CALL lbc_lnk_gpu( 'ice_var_agg_gpu',  af_i, xhf, au_i, av_i )
#else
   CALL lbc_lnk(     'ice_var_agg_gpu',  af_i,'F',1._wp,  xhf,'F',1._wp,  au_i,'U',1._wp,  av_i,'V',1._wp )
#endif

   !$acc parallel loop collapse(2)
   DO jj=Njs0-nn_hls, Nje0+nn_hls
      DO ji=Nis0-nn_hls, Nie0+nn_hls
         ! For diagnostics:
         kmsk_ice_t(ji,jj) = MERGE( 0  ,  INT(xmskt(ji,jj))    ,  at_i(ji,jj) < rAmin_fld )
         kmsk_ice_f(ji,jj) = MERGE( 0  ,  INT(xmskf(ji,jj))    ,  af_i(ji,jj) < rAmin_fld )
         ! For rheology and diags:
         kmsk_ice_u(ji,jj) = MERGE( 0  ,  INT(umask(ji,jj,1))  ,  au_i(ji,jj) < rAmin_fld )
         kmsk_ice_v(ji,jj) = MERGE( 0  ,  INT(vmask(ji,jj,1))  ,  av_i(ji,jj) < rAmin_fld )
      END DO
   END DO
   !$acc end parallel loop

   !$acc end data
   IF( ln_timing )  CALL timing_stop('agg_gpu')

END SUBROUTINE ice_var_agg_gpu
